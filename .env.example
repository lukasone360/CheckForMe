# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# When unset, the site uses https://checkforme.vercel.app.
NEXT_PUBLIC_SITE_URL=https://checkforme.vercel.app

# Optional contact address shown on the contact page, privacy policy, terms, and footer.
# When unset, those pages show the placeholder hello@[our-domain], which is not a real inbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Leave blank until you are ready to serve ads. Ad slots render nothing, ads.txt
# returns 404, and the AdSense script is not loaded unless the client id is set.
# A slot also stays empty until its numeric slot id is set.
# Example client: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=

# Numeric AdSense ad slot ids. Both the client id and the slot id must be set.
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
