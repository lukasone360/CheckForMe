# Public site URL used for canonical links, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://checkforme.local

# Optional contact address shown in the privacy policy, terms, and footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Leave blank until you are ready to serve ads. The ad slot component
# renders nothing when this is empty, and the AdSense script is not loaded.
# Example: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=
